# Public, owner-confirmed business details only. Never put credentials here.
# Optional preferred public HTTPS origin, e.g. https://your-confirmed-domain.com.
# Netlify uses its assigned URL automatically when this is blank.
# Set a custom domain only after owning it and configuring it in Netlify.
SITE_URL=
# Optional token supplied by Google Search Console after creating your property.
GOOGLE_SITE_VERIFICATION=
# Next.js includes NEXT_PUBLIC_* values in the browser bundle at build time.
# Blank values use the owner-confirmed booking URL and phone in reservations.ts.
# Add an email only when confirmed; it is hidden otherwise.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_RESERVATIONS_PHONE=
NEXT_PUBLIC_RESERVATIONS_EMAIL=

# Optional room-specific booking destinations (otherwise use the main link).
NEXT_PUBLIC_BOOKING_DELUXE_URL=
NEXT_PUBLIC_BOOKING_FAMILY_URL=
NEXT_PUBLIC_BOOKING_VILLA_URL=

# Optional confirmed map link and/or Google Maps HTTPS embed URL.
NEXT_PUBLIC_RESORT_MAPS_URL=
NEXT_PUBLIC_RESORT_MAP_EMBED_URL=
